@import '@awesome.me/webawesome/dist/styles/layers.css';
@import '@awesome.me/webawesome/dist/styles/color/palettes/default.css';
@import url('https://fonts.bunny.net/css2?family=Inter:wght@300..700&family=Space+Grotesk:wght@400..700&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400..600;1,400..600&display=swap');

@layer wa-theme {

    .wa-theme-portal,
    .wa-theme-portal.wa-light,
    .wa-theme-portal .wa-light,
    .wa-theme-portal.wa-dark .wa-invert,
    .wa-theme-portal .wa-dark .wa-invert,
    .wa-light .wa-theme-portal,
    .wa-dark .wa-theme-portal.wa-invert,
    .wa-dark .wa-theme-portal .wa-invert {
        /* #region Colors (Light) ~~~~~~~~~~~~~~~~~~~~~ */
        color-scheme: light;
        color: var(--wa-color-text-normal);

        --wa-color-surface-raised: #f7f2e9;
        --wa-color-surface-default: #ede8dc;
        --wa-color-surface-lowered: #e3ddd0;
        --wa-color-surface-border: #c8c0b0;

        --wa-color-text-normal: #1a2e1e;
        --wa-color-text-quiet: #4a6050;
        --wa-color-text-link: #194430;

        --wa-color-overlay-modal: color-mix(in oklab, #1a2e1e 50%, transparent);
        --wa-color-overlay-inline: color-mix(in oklab, #a0b5a1 20%, transparent);

        --wa-color-shadow: color-mix(in oklab,
                #0d2219 calc(var(--wa-shadow-blur-scale) * 4% + 6%),
                transparent);

        --wa-color-focus: #2d6040;

        --wa-color-mix-hover: black 8%;
        --wa-color-mix-active: black 16%;

        --wa-color-brand-fill-quiet: #dceadc;
        --wa-color-brand-fill-normal: #b8d4b8;
        --wa-color-brand-fill-loud: #528C5C;
        --wa-color-brand-border-quiet: #8cb88c;
        --wa-color-brand-border-normal: #528C5C;
        --wa-color-brand-border-loud: #194430;
        --wa-color-brand-on-quiet: #194430;
        --wa-color-brand-on-normal: #163527;
        --wa-color-brand-on-loud: #FCE9C8;

        --wa-color-success-fill-quiet: var(--wa-color-success-95);
        --wa-color-success-fill-normal: var(--wa-color-success-90);
        --wa-color-success-fill-loud: var(--wa-color-success-50);
        --wa-color-success-border-quiet: var(--wa-color-success-80);
        --wa-color-success-border-normal: var(--wa-color-success-60);
        --wa-color-success-border-loud: var(--wa-color-success-40);
        --wa-color-success-on-quiet: var(--wa-color-success-40);
        --wa-color-success-on-normal: var(--wa-color-success-30);
        --wa-color-success-on-loud: white;

        --wa-color-warning-fill-quiet: #fdf5e4;
        --wa-color-warning-fill-normal: #f5e0a8;
        --wa-color-warning-fill-loud: #C49A3C;
        --wa-color-warning-border-quiet: #e8cc7a;
        --wa-color-warning-border-normal: #C49A3C;
        --wa-color-warning-border-loud: #8B6A1A;
        --wa-color-warning-on-quiet: #8B6A1A;
        --wa-color-warning-on-normal: #6b4f10;
        --wa-color-warning-on-loud: #1a0f00;

        --wa-color-danger-fill-quiet: var(--wa-color-danger-95);
        --wa-color-danger-fill-normal: var(--wa-color-danger-90);
        --wa-color-danger-fill-loud: var(--wa-color-danger-50);
        --wa-color-danger-border-quiet: var(--wa-color-danger-80);
        --wa-color-danger-border-normal: var(--wa-color-danger-60);
        --wa-color-danger-border-loud: var(--wa-color-danger-40);
        --wa-color-danger-on-quiet: var(--wa-color-danger-40);
        --wa-color-danger-on-normal: var(--wa-color-danger-30);
        --wa-color-danger-on-loud: white;

        --wa-color-neutral-fill-quiet: #f0f3f7;
        --wa-color-neutral-fill-normal: #dde4ed;
        --wa-color-neutral-fill-loud: #4A6B8A;
        --wa-color-neutral-border-quiet: #bfcdd9;
        --wa-color-neutral-border-normal: #8094a8;
        --wa-color-neutral-border-loud: #4A6B8A;
        --wa-color-neutral-on-quiet: #2E4D6B;
        --wa-color-neutral-on-normal: #1a3148;
        --wa-color-neutral-on-loud: white;
        /* #endregion */
    }

    .wa-theme-portal.wa-dark,
    .wa-theme-portal .wa-dark,
    .wa-theme-portal.wa-invert,
    .wa-theme-portal .wa-invert,
    .wa-dark .wa-theme-portal,
    .wa-light .wa-theme-portal.wa-invert,
    .wa-light .wa-theme-portal .wa-invert {
        /* #region Colors (Dark) ~~~~~~~~~~~~~~~~~~~~~~ */
        color-scheme: dark;
        color: var(--wa-color-text-normal);

        --wa-color-surface-raised: #152b1e;
        --wa-color-surface-default: #0d1a12;
        --wa-color-surface-lowered: color-mix(in oklab, #0d1a12, black 25%);
        --wa-color-surface-border: #243d2c;

        --wa-color-text-normal: #FCE9C8;
        --wa-color-text-quiet: #a0b89a;
        --wa-color-text-link: #6D9B6D;

        --wa-color-overlay-modal: color-mix(in oklab, black 65%, transparent);
        --wa-color-overlay-inline: color-mix(in oklab, #607562 12%, transparent);

        --wa-color-shadow: color-mix(in oklab,
                var(--wa-color-surface-lowered) calc(var(--wa-shadow-blur-scale) * 32% + 40%),
                transparent);

        --wa-color-focus: #6D9B6D;

        --wa-color-mix-hover: white 8%;
        --wa-color-mix-active: white 14%;

        --wa-color-brand-fill-quiet: #071510;
        --wa-color-brand-fill-normal: #0d2219;
        --wa-color-brand-fill-loud: #528C5C;
        --wa-color-brand-border-quiet: #163527;
        --wa-color-brand-border-normal: #2d6040;
        --wa-color-brand-border-loud: #6D9B6D;
        --wa-color-brand-on-quiet: #6D9B6D;
        --wa-color-brand-on-normal: #8cb88c;
        --wa-color-brand-on-loud: #FCE9C8;

        --wa-color-success-fill-quiet: var(--wa-color-success-10);
        --wa-color-success-fill-normal: var(--wa-color-success-20);
        --wa-color-success-fill-loud: var(--wa-color-success-50);
        --wa-color-success-border-quiet: var(--wa-color-success-30);
        --wa-color-success-border-normal: var(--wa-color-success-50);
        --wa-color-success-border-loud: var(--wa-color-success-70);
        --wa-color-success-on-quiet: var(--wa-color-success-70);
        --wa-color-success-on-normal: var(--wa-color-success-80);
        --wa-color-success-on-loud: white;

        --wa-color-warning-fill-quiet: #1f1400;
        --wa-color-warning-fill-normal: #3a2800;
        --wa-color-warning-fill-loud: #C49A3C;
        --wa-color-warning-border-quiet: #5c3f00;
        --wa-color-warning-border-normal: #8B6A1A;
        --wa-color-warning-border-loud: #C49A3C;
        --wa-color-warning-on-quiet: #C49A3C;
        --wa-color-warning-on-normal: #e8cc7a;
        --wa-color-warning-on-loud: #1a0f00;

        --wa-color-danger-fill-quiet: var(--wa-color-danger-10);
        --wa-color-danger-fill-normal: var(--wa-color-danger-20);
        --wa-color-danger-fill-loud: var(--wa-color-danger-50);
        --wa-color-danger-border-quiet: var(--wa-color-danger-30);
        --wa-color-danger-border-normal: var(--wa-color-danger-50);
        --wa-color-danger-border-loud: var(--wa-color-danger-70);
        --wa-color-danger-on-quiet: var(--wa-color-danger-70);
        --wa-color-danger-on-normal: var(--wa-color-danger-80);
        --wa-color-danger-on-loud: white;

        --wa-color-neutral-fill-quiet: #0e1218;
        --wa-color-neutral-fill-normal: #1a2233;
        --wa-color-neutral-fill-loud: #4A6B8A;
        --wa-color-neutral-border-quiet: #1e2d40;
        --wa-color-neutral-border-normal: #2E4D6B;
        --wa-color-neutral-border-loud: #8094a8;
        --wa-color-neutral-on-quiet: #8094a8;
        --wa-color-neutral-on-normal: #bfcdd9;
        --wa-color-neutral-on-loud: white;
        /* #endregion */
    }

    .wa-theme-portal,
    .wa-theme-portal.wa-light,
    .wa-theme-portal .wa-light,
    .wa-theme-portal.wa-dark,
    .wa-theme-portal .wa-dark,
    .wa-theme-portal.wa-invert,
    .wa-theme-portal .wa-invert {
        font-family: var(--wa-font-family-body);

        /* #region Fonts ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
        --wa-font-family-body: 'Inter', ui-sans-serif, sans-serif;
        --wa-font-family-heading: 'Space Grotesk', 'Inter', sans-serif;
        --wa-font-family-code: 'JetBrains Mono', ui-monospace, monospace;
        --wa-font-family-longform: 'Lora', ui-serif, serif;

        --wa-font-size-scale: 1;
        --wa-font-size-2xs: round(calc(var(--wa-font-size-xs) / 1.125), 1px);
        /* 11px */
        --wa-font-size-xs: round(calc(var(--wa-font-size-s) / 1.125), 1px);
        /* 12px */
        --wa-font-size-s: round(calc(var(--wa-font-size-m) / 1.125), 1px);
        /* 14px */
        --wa-font-size-m: calc(1rem * var(--wa-font-size-scale));
        /* 16px */
        --wa-font-size-l: round(calc(var(--wa-font-size-m) * 1.125 * 1.125), 1px);
        /* 20px */
        --wa-font-size-xl: round(calc(var(--wa-font-size-l) * 1.125 * 1.125), 1px);
        /* 25px */
        --wa-font-size-2xl: round(calc(var(--wa-font-size-xl) * 1.125 * 1.125), 1px);
        /* 32px */
        --wa-font-size-3xl: round(calc(var(--wa-font-size-2xl) * 1.125 * 1.125), 1px);
        /* 41px */
        --wa-font-size-4xl: round(calc(var(--wa-font-size-3xl) * 1.125 * 1.125), 1px);
        /* 52px */

        --wa-font-size-smaller: round(calc(1em / 1.125), 1px);
        --wa-font-size-larger: round(calc(1em * 1.125 * 1.125), 1px);

        --wa-font-weight-light: 300;
        --wa-font-weight-normal: 400;
        --wa-font-weight-semibold: 500;
        --wa-font-weight-bold: 700;

        --wa-font-weight-body: var(--wa-font-weight-normal);
        --wa-font-weight-heading: var(--wa-font-weight-bold);
        --wa-font-weight-code: var(--wa-font-weight-normal);
        --wa-font-weight-longform: var(--wa-font-weight-normal);
        --wa-font-weight-action: var(--wa-font-weight-semibold);

        --wa-line-height-condensed: 1.25;
        --wa-line-height-normal: 1.6;
        --wa-line-height-expanded: 2;

        --wa-link-decoration-default: none;
        --wa-link-decoration-hover: underline;
        /* #endregion */

        /* #region Space ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
        --wa-space-scale: 1;
        --wa-space-3xs: calc(var(--wa-space-scale) * 0.125rem);
        /* 2px */
        --wa-space-2xs: calc(var(--wa-space-scale) * 0.25rem);
        /* 4px */
        --wa-space-xs: calc(var(--wa-space-scale) * 0.5rem);
        /* 8px */
        --wa-space-s: calc(var(--wa-space-scale) * 0.75rem);
        /* 12px */
        --wa-space-m: calc(var(--wa-space-scale) * 1rem);
        /* 16px */
        --wa-space-l: calc(var(--wa-space-scale) * 1.5rem);
        /* 24px */
        --wa-space-xl: calc(var(--wa-space-scale) * 2rem);
        /* 32px */
        --wa-space-2xl: calc(var(--wa-space-scale) * 2.5rem);
        /* 40px */
        --wa-space-3xl: calc(var(--wa-space-scale) * 3rem);
        /* 48px */
        --wa-space-4xl: calc(var(--wa-space-scale) * 4rem);
        /* 64px */

        --wa-content-spacing: var(--wa-space-l);
        /* #endregion */

        /* #region Borders ~~~~~~~~~~~~~~~~~~~~~~~~~~ */
        --wa-border-style: solid;

        --wa-border-width-scale: 1;
        --wa-border-width-s: calc(var(--wa-border-width-scale) * 0.0625rem);
        --wa-border-width-m: calc(var(--wa-border-width-scale) * 0.125rem);
        --wa-border-width-l: calc(var(--wa-border-width-scale) * 0.1875rem);
        /* #endregion */

        /* #region Rounding ~~~~~~~~~~~~~~~~~~~~~~~~~ */
        --wa-border-radius-scale: 1.25;
        --wa-border-radius-s: calc(var(--wa-border-radius-scale) * 0.1875rem);
        --wa-border-radius-m: calc(var(--wa-border-radius-scale) * 0.375rem);
        --wa-border-radius-l: calc(var(--wa-border-radius-scale) * 0.75rem);

        --wa-border-radius-pill: 9999px;
        --wa-border-radius-circle: 50%;
        --wa-border-radius-square: 0px;
        /* #endregion */

        /* #region Focus ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
        --wa-focus-ring-style: solid;
        --wa-focus-ring-width: 0.125rem;
        /* 2px */
        --wa-focus-ring: var(--wa-focus-ring-style) var(--wa-focus-ring-width) var(--wa-color-focus);
        --wa-focus-ring-offset: 0.125rem;
        /* 2px */
        /* #endregion */

        /* #region Shadows ~~~~~~~~~~~~~~~~~~~~~~~~~~ */
        --wa-shadow-offset-x-scale: 0;
        --wa-shadow-offset-x-s: calc(var(--wa-shadow-offset-x-scale) * 0.125rem);
        --wa-shadow-offset-x-m: calc(var(--wa-shadow-offset-x-scale) * 0.25rem);
        --wa-shadow-offset-x-l: calc(var(--wa-shadow-offset-x-scale) * 0.5rem);

        --wa-shadow-offset-y-scale: 1;
        --wa-shadow-offset-y-s: calc(var(--wa-shadow-offset-y-scale) * 0.125rem);
        --wa-shadow-offset-y-m: calc(var(--wa-shadow-offset-y-scale) * 0.25rem);
        --wa-shadow-offset-y-l: calc(var(--wa-shadow-offset-y-scale) * 0.5rem);

        --wa-shadow-blur-scale: 2;
        --wa-shadow-blur-s: calc(var(--wa-shadow-blur-scale) * 0.125rem);
        --wa-shadow-blur-m: calc(var(--wa-shadow-blur-scale) * 0.25rem);
        --wa-shadow-blur-l: calc(var(--wa-shadow-blur-scale) * 0.5rem);

        --wa-shadow-spread-scale: -0.5;
        --wa-shadow-spread-s: calc(var(--wa-shadow-spread-scale) * 0.125rem);
        --wa-shadow-spread-m: calc(var(--wa-shadow-spread-scale) * 0.25rem);
        --wa-shadow-spread-l: calc(var(--wa-shadow-spread-scale) * 0.5rem);

        --wa-shadow-s: var(--wa-shadow-offset-x-s) var(--wa-shadow-offset-y-s) var(--wa-shadow-blur-s) var(--wa-shadow-spread-s) var(--wa-color-shadow);
        --wa-shadow-m: var(--wa-shadow-offset-x-m) var(--wa-shadow-offset-y-m) var(--wa-shadow-blur-m) var(--wa-shadow-spread-m) var(--wa-color-shadow);
        --wa-shadow-l: var(--wa-shadow-offset-x-l) var(--wa-shadow-offset-y-l) var(--wa-shadow-blur-l) var(--wa-shadow-spread-l) var(--wa-color-shadow);
        /* #endregion */

        /* #region Transitions ~~~~~~~~~~~~~~~~~~~~~~ */
        --wa-transition-easing: cubic-bezier(0.4, 0, 0.2, 1);
        --wa-transition-slow: 250ms;
        --wa-transition-normal: 120ms;
        --wa-transition-fast: 60ms;
        /* #endregion */

        /* #region Components ~~~~~~~~~~~~~~~~~~~~~~~ */
        /* Form Controls */
        --wa-form-control-background-color: var(--wa-color-surface-default);

        --wa-form-control-border-color: var(--wa-color-neutral-border-normal);
        --wa-form-control-border-style: var(--wa-border-style);
        --wa-form-control-border-width: var(--wa-border-width-s);
        --wa-form-control-border-radius: var(--wa-border-radius-m);

        --wa-form-control-activated-color: var(--wa-color-brand-fill-loud);

        --wa-form-control-label-color: var(--wa-color-text-normal);
        --wa-form-control-label-font-weight: var(--wa-font-weight-semibold);
        --wa-form-control-label-line-height: var(--wa-line-height-condensed);

        --wa-form-control-value-color: var(--wa-color-text-normal);
        --wa-form-control-value-font-weight: var(--wa-font-weight-body);
        --wa-form-control-value-line-height: var(--wa-line-height-condensed);

        --wa-form-control-hint-color: var(--wa-color-text-quiet);
        --wa-form-control-hint-font-weight: var(--wa-font-weight-body);
        --wa-form-control-hint-line-height: var(--wa-line-height-normal);

        --wa-form-control-placeholder-color: var(--wa-color-gray-50);

        --wa-form-control-required-content: '*';
        --wa-form-control-required-content-color: var(--wa-color-danger-on-quiet);
        --wa-form-control-required-content-offset: 0.1em;

        --wa-form-control-padding-block: 0.75em;
        --wa-form-control-padding-inline: 1em;
        --wa-form-control-height: round(calc(2 * var(--wa-form-control-padding-block) + 1em * var(--wa-form-control-value-line-height)),
                1px);
        --wa-form-control-toggle-size: round(1.25em, 1px);

        /* Panels */
        --wa-panel-border-style: var(--wa-border-style);
        --wa-panel-border-width: var(--wa-border-width-s);
        --wa-panel-border-radius: var(--wa-border-radius-l);

        /* Tooltips */
        --wa-tooltip-arrow-size: 0.3125rem;

        --wa-tooltip-background-color: var(--wa-color-neutral-fill-loud);

        --wa-tooltip-border-color: transparent;
        --wa-tooltip-border-style: var(--wa-border-style);
        --wa-tooltip-border-width: 0;
        --wa-tooltip-border-radius: var(--wa-border-radius-s);

        --wa-tooltip-content-color: white;
        --wa-tooltip-font-size: var(--wa-font-size-xs);
        --wa-tooltip-line-height: var(--wa-line-height-normal);
        /* #endregion */
    }
}

@layer wa-theme-overrides {
    .wa-theme-portal {
        wa-badge {
            border-radius: var(--wa-border-radius-s);
            font-weight: var(--wa-font-weight-semibold);
            letter-spacing: 0.04em;
            text-transform: uppercase;
            font-size: var(--wa-font-size-2xs);
        }

        wa-callout {
            border-inline-start-width: 0.25rem;

            &:is([appearance~='outlined']) {
                border-color: var(--wa-color-border-normal);
            }
        }

        wa-card {
            background-color: var(--wa-color-surface-raised);
            box-shadow: var(--wa-shadow-s);
        }

        wa-card::part(header) {
            border-bottom-color: var(--wa-color-surface-border);
        }

        wa-card::part(footer) {
            border-top-color: var(--wa-color-surface-border);
            background-color: var(--wa-color-surface-lowered);
        }

        input[type='checkbox'],
        wa-checkbox,
        wa-tree-item::part(checkbox__control) {
            --checked-icon-color: white;
        }

        wa-switch {
            --height: 1.375em;
        }

        wa-tag {
            font-weight: var(--wa-font-weight-semibold);
            font-size: var(--wa-font-size-xs);
            letter-spacing: 0.02em;
        }

        wa-button,
        button,
        input[type='button'],
        input[type='reset'],
        input[type='submit'],
        a.wa-button {

            &[appearance='accent'],
            &.wa-accent {

                &:where(:not(wa-button)),
                &::part(base) {
                    font-weight: var(--wa-font-weight-semibold);
                    letter-spacing: 0.01em;
                }
            }
        }
    }
}